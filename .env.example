# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，绝不要提交。
#
#   cp .env.example .env
#
# 本地运行时加载：
#   set -a; source .env; set +a
#
# GitHub Actions 上不要用这个文件——把同名值存到
# 仓库 Settings → Secrets and variables → Actions → New repository secret。

# Anthropic API key（用于自动生成 insights.json）
# 获取：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 生成用的模型。默认 claude-opus-5。
ANTHROPIC_MODEL=claude-opus-5
